# Postgres / TimescaleDB
DATABASE_URL="postgresql://solax:solax_dev_password@localhost:5432/solax"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth (v5)
AUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_PIN="258025"

# Solax Cloud API
# Default tokenId used when a device doesn't specify its own tokenId.
# Obtain it in SolaxCloud: Account -> API -> "Obtain tokenID".
SOLAX_TOKEN_ID="your-solaxcloud-tokenid"
SOLAX_API_BASE_URL="https://www.solaxcloud.com:9443/proxy/api"

# Worker polling
# NOTE: the SolaxCloud API is queried by each device's Registration No
# (Wi-Fi/LAN dongle SN), not the inverter serial. The free tier allows
# ~10 requests/minute per token and rejects bursts, so the worker spaces
# requests evenly at SOLAX_RATE_LIMIT_PER_MIN. A full 178-device cycle then
# takes ~22 min, so keep POLL_INTERVAL_SECONDS at or above that.
POLL_INTERVAL_SECONDS="1500"
SOLAX_RATE_LIMIT_PER_MIN="8"

# Operator alerts (Telegram) + daily DB backup. Optional — if unset, alarms are
# still stored/shown but not pushed, and backups stay local.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Production only (docker-compose.prod.yml) ---
# In prod, DATABASE_URL/REDIS_URL point at the compose service names:
#   DATABASE_URL="postgresql://solax:<pass>@postgres:5432/solax"
#   REDIS_URL="redis://redis:6379"
POSTGRES_USER="solax"
POSTGRES_PASSWORD="change-me-strong"
POSTGRES_DB="solax"
# Domain for the Caddy HTTPS reverse proxy (the "proxy" profile).
DOMAIN="solax.example.com"

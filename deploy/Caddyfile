# Auto-HTTPS reverse proxy. Set DOMAIN in .env (e.g. solax.example.com) with an
# A record pointing at the VPS; Caddy fetches and renews the TLS cert itself.
# Falls back to :80 if DOMAIN is unset.
{$DOMAIN::80} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy web:3000
}
